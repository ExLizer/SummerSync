<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Static metadata inspection of managed assemblies (types, signatures, references) and the
    check that our net35 assemblies only use APIs present in the game's own BCL.
    Assemblies are read as data: nothing is loaded or executed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>asminspect</AssemblyName>
    <RootNamespace>SummerSync.AsmInspect</RootNamespace>
  </PropertyGroup>

</Project>
