<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A SummerSync network peer without the game: the same session code and UDP transport as the mod, driven
    from a console. For trying the protocol between processes, and as the second player on one machine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>netprobe</AssemblyName>
    <RootNamespace>SummerSync.NetProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SummerSync.Core\SummerSync.Core.csproj" />
  </ItemGroup>

</Project>
